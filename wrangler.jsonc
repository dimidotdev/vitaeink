{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vitaeink",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "vitaeink.dimi.dev.br",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
